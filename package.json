{
  "name": "catat-neon",
  "version": "3.0.0",
  "private": true,
  "description": "Daftar tugas dengan Express, Prisma, dan Neon PostgreSQL.",
  "type": "module",
  "engines": { "node": "^22.18.0 || ^24.11.0 || >=26.0.0" },
  "scripts": {
